// Windows resource file — embeds the UAC manifest
#include "winuser.h"

// Icon
1 ICON "icon.ico"

// UAC manifest
1 RT_MANIFEST "manifest.xml"

// Version info
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "ProxyLink"
      VALUE "FileDescription",  "ProxyLink Support Tool"
      VALUE "FileVersion",      "1.0.0"
      VALUE "InternalName",     "plsupport"
      VALUE "OriginalFilename", "ProxyLinkSupport.exe"
      VALUE "ProductName",      "ProxyLink Support Tool"
      VALUE "ProductVersion",   "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
